# Copy to .env for local development. Never commit .env.
APP_ENV=development

# Leave blank locally to use a SQLite file (zero setup).
# Production: a Postgres URL from Neon, e.g.
#   postgresql://user:pass@ep-xxx.aws.neon.tech/portfolio?sslmode=require
DATABASE_URL=

# Dashboard ETL (python -m app.etl). Usernames have defaults; token is optional.
GITHUB_USERNAME=PradyumnaPrasad
LEETCODE_USERNAME=Pradyumna_Prasad
GITHUB_TOKEN=          # optional — unlocks the GitHub contribution calendar

# Workshop tools (/workshop). Optional — without it, search falls back to
# keyword matching and the "ask my portfolio" chatbot is disabled.
GEMINI_API_KEY=
